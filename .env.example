# Supabase (project: baaddaravxmnevmovpad)
NEXT_PUBLIC_SUPABASE_URL=https://baaddaravxmnevmovpad.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Direct Postgres connection (Supabase Dashboard -> Connect -> Transaction pooler)
DATABASE_URL=
# Server-side only; never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=   # only for identity-linked Console keys (wrkspc_…)

# Trigger.dev
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Langfuse (optional in dev; gateway no-ops without keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Sentry (optional in dev)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Phase 7 — routing + accountability
GMAIL_SERVICE_ACCOUNT_JSON=   # Google Workspace service account (domain-wide delegation, gmail.send) for the persona mailboxes
GHL_API_KEY=                  # GoHighLevel private integration token (SMS nudges + opportunity mirror)
GHL_LOCATION_ID=
GHL_PIPELINE_ID=              # or GHL_PIPELINE_NAME — the pipeline whose stages carry the FCC vocabulary
GHL_WEBHOOK_SECRET=           # shared secret for /api/webhooks/ghl (?key= or x-athena-secret)
CALENDLY_WEBHOOK_SIGNING_KEY= # from the Calendly webhook subscription
MANAGER_SMS_TO=               # phone for the +24h manager escalation
APP_URL=                      # public base URL for accept links in intro emails

# Enrichment
# GHL_API_KEY + GHL_LOCATION_ID (above) also drive the CRM history lookup on import
RESEARCH_MIN_SCORE=70         # research only candidates scoring at/above this
RESEARCH_DAILY_BUDGET_USD=25  # hard cap on research spend per day (tokens + web searches)
